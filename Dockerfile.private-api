FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY dentiste_source.zip /build/dentiste_source.zip
RUN unzip -q /build/dentiste_source.zip \
    && mv /build/dentiste_enterprise_v4/api-server /app \
    && rm -rf /build/dentiste_enterprise_v4 /build/dentiste_source.zip

WORKDIR /app
RUN pip install --no-cache-dir -r requirements.txt

COPY start-private-api.sh /usr/local/bin/start-private-api.sh
RUN chmod 755 /usr/local/bin/start-private-api.sh

EXPOSE 8000
CMD ["/usr/local/bin/start-private-api.sh"]
