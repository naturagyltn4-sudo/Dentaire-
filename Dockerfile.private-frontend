FROM node:22-alpine AS builder



WORKDIR /build

COPY dentiste_source.zip /build/dentiste_source.zip

RUN apk add --no-cache unzip \

    && unzip -q /build/dentiste_source.zip \

    && mv /build/dentiste_enterprise_v4/validation-private-frontend /app \

    && rm -rf /build/dentiste_enterprise_v4 /build/dentiste_source.zip



WORKDIR /app

RUN npm install -g pnpm@10.15.1 \

    && pnpm install --frozen-lockfile \

    && pnpm run check \

    && pnpm run test -- --run \

    && pnpm run build



FROM nginx:1.27-alpine

COPY --from=builder /app/dist/public /usr/share/nginx/html

COPY private-frontend-nginx.conf /etc/nginx/templates/private-frontend.conf.template



RUN addgroup -S nginxapp && adduser -S -G nginxapp nginxapp \

    && chown -R nginxapp:nginxapp /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx /run

USER nginxapp



EXPOSE 8000

CMD ["sh", "-c", "DNS_RESOLVER=$(awk '/^nameserver[[:space:]]+/{print $2; exit}' /etc/resolv.conf); test -n \"$DNS_RESOLVER\"; sed \"s|__RAILWAY_DNS__|$DNS_RESOLVER|g\" /etc/nginx/templates/private-frontend.conf.template > /etc/nginx/conf.d/default.conf; exec nginx -g 'daemon off;'"]

